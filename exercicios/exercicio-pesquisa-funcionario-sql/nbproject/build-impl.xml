<?xml version="1.0" encoding="UTF-8"?>
<project name="TrabalhoPratico04-impl" default="default" basedir="..">
    <path id="classpath">
        <fileset dir="lib">
            <include name="*.jar"/>
        </fileset>
        <pathelement location="build/classes"/>
    </path>
    <target name="init">
        <mkdir dir="build/classes"/>
    </target>
    <target name="compile" depends="init">
        <javac srcdir="src" destdir="build/classes" source="1.8" target="1.8" includeantruntime="false" classpathref="classpath"/>
    </target>
    <target name="run" depends="compile">
        <java classname="trabalhopratico04.FrmFuncionario" fork="true">
            <classpath refid="classpath"/>
        </java>
    </target>
    <target name="jar" depends="compile">
        <mkdir dir="dist"/>
        <jar destfile="dist/TrabalhoPratico04.jar">
            <fileset dir="build/classes"/>
        </jar>
    </target>
    <target name="clean">
        <delete dir="build"/>
        <delete dir="dist"/>
    </target>
    <target name="default" depends="compile">
    </target>
</project>
