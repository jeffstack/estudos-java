<?xml version="1.0" encoding="UTF-8"?>
<project name="TP03-impl" default="default" basedir="..">
    <property file="nbproject/project.properties" />
    <target name="init">
        <mkdir dir="${build.classes.dir}" />
    </target>
    <target name="compile" depends="init">
        <javac srcdir="${src.dir}" destdir="${build.classes.dir}" encoding="${javac.encoding}" source="${javac.source}" target="${javac.target}" includeantruntime="false" />
    </target>
    <target name="jar" depends="compile">
        <mkdir dir="${dist.dir}" />
        <jar jarfile="${dist.dir}/TP03.jar" manifest="manifest.mf" basedir="${build.classes.dir}" />
    </target>
    <target name="clean">
        <delete dir="${build.dir}" />
        <delete dir="${dist.dir}" />
    </target>
    <target name="run" depends="compile">
        <java classname="${main.class}" classpath="${build.classes.dir}" fork="true" />
    </target>
    <target name="default" depends="jar" />
</project>
